# T-Dongle-S3 16MB — USB NCM gadget + HTTP/WebDAV
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_FREERTOS_HZ=1000

# CRITICAL: release USB PHY from Serial/JTAG so TinyUSB OTG can enumerate as NCM.
CONFIG_USJ_ENABLE_USB_SERIAL_JTAG=n
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG is not set
# CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG is not set

# TinyUSB — NCM network gadget (Windows UsbNcm / USB Ethernet)
CONFIG_TINYUSB_NET_MODE_NCM=y
# CONFIG_TINYUSB_NET_MODE_NONE is not set
# CONFIG_TINYUSB_NET_MODE_ECM_RNDIS is not set
CONFIG_TINYUSB_TASK_AFFINITY_CPU0=y
# Init TinyUSB in driver_install (not deferred) — more reliable after USB flash
# CONFIG_TINYUSB_INIT_IN_DEFAULT_TASK is not set
CONFIG_TINYUSB_DESC_USE_ESPRESSIF_VID=y
# CONFIG_TINYUSB_DESC_USE_DEFAULT_PID is not set
CONFIG_TINYUSB_DESC_CUSTOM_PID=0x4001
CONFIG_TINYUSB_DESC_PRODUCT_STRING="RNDISStorage"
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="RNDISLab"
CONFIG_TINYUSB_DESC_SERIAL_STRING="RNDISSTORAGE01"
CONFIG_TINYUSB_TASK_STACK_SIZE=8192

CONFIG_LWIP_DHCPS=y
CONFIG_ESP_NETIF_TCPIP_LWIP=y
# SoftAP → USB NCM pivot (operator Wi-Fi reaches host on 203.0.113.2).
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y
CONFIG_LWIP_IPV4_NAPT_PORTMAP=y
# Larger TCP windows help USB-NCM + SoftAP file transfers.
CONFIG_LWIP_TCP_MSS=1460
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=8192
CONFIG_LWIP_TCP_WND_DEFAULT=8192
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64

CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y

CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_ESP_INT_WDT_TIMEOUT_MS=300
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
